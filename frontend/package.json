{
  "name": "@wealthos/frontend",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:demo": "WEALTHOS_DIST=dist-demo VITE_WEALTHOS_MODE=demo vite build && WEALTHOS_DIST=dist-demo WEALTHOS_API_TARGET=http://127.0.0.1:3100 PORT=5181 node scripts/serve.mjs",
    "preview:api": "WEALTHOS_API_TARGET=http://127.0.0.1:8787 PORT=5182 node scripts/serve.mjs",
    "preview:readonly": "WEALTHOS_API_TARGET=http://127.0.0.1:8787 VITE_WEALTHOS_COMMANDS=readonly WEALTHOS_DIST=dist-readonly PORT=5183 node scripts/serve.mjs",
    "typecheck": "tsc -b --pretty",
    "check:locale": "node scripts/check-locale.mjs",
    "test": "vitest run",
    "mock": "node mock/server.mjs",
    "e2e": "node e2e/smoke.mjs",
    "consistency": "node e2e/consistency.mjs",
    "contract:probe": "node e2e/contract-probe.mjs",
    "contract:responses": "node e2e/response-contract.mjs",
    "e2e:real": "node e2e/real-backend-smoke.mjs",
    "e2e:routes": "node e2e/route-lifecycle.mjs",
    "e2e:resilience": "node e2e/resilience.mjs",
    "e2e:navigation": "node e2e/navigation.mjs",
    "e2e:period": "node e2e/period-filter.mjs",
    "e2e:filter-contract": "node e2e/filter-contract.mjs",
    "e2e:real-analytics": "node e2e/real-analytics.mjs",
    "e2e:modules": "node e2e/module-recovery.mjs && node e2e/partial-read-models.mjs",
    "e2e:preferences": "node e2e/preferences-print.mjs",
    "e2e:i18n": "node e2e/i18n.mjs",
    "e2e:pairing": "node e2e/pairing.mjs",
    "e2e:workflow": "node e2e/workflow-completeness.mjs",
    "e2e:recovery": "node e2e/recovery-contract.mjs",
    "e2e:boundaries": "node e2e/response-boundaries.mjs",
    "e2e:accounts": "node e2e/accounts.mjs",
    "e2e:overview": "node e2e/overview.mjs",
    "e2e:flows": "node e2e/flow-trends.mjs",
    "e2e:settings": "node e2e/settings-cashflow.mjs",
    "e2e:offline": "node e2e/offline.mjs",
    "e2e:analytics": "node e2e/analytics-investments.mjs",
    "e2e:a11y": "node e2e/accessibility.mjs",
    "e2e:ui": "node e2e/ui-quality.mjs && node e2e/performance-shell.mjs && node e2e/contract-recovery.mjs",
    "e2e:demo": "node e2e/demo-mode.mjs",
    "e2e:mock-persona": "node e2e/mock-persona.mjs",
    "e2e:read-models": "node e2e/contract-read-models.mjs",
    "e2e:commands": "node e2e/transaction-commands.mjs",
    "e2e:real-writes": "node e2e/real-write-sandbox.mjs",
    "check:assets": "node scripts/check-build-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@wealthos/api-client": "workspace:*",
    "echarts": "^5.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
